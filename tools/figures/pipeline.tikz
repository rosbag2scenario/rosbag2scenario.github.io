% Fig. 2 drawing: Rosbag2Scenario pipeline as a block diagram, from the recording to the OpenSCENARIO file and traffic plan.
% Read left to right: input -> perception source (online | offline) -> trajectory reconstruction -> scenario export -> output.
% Used by Figures/pipeline_figure.tex. Colours repeat those of Fig. 1 (fig_overview_common.tikz). Units are cm.
%
% Editing guide
%   colours ........ \definecolor block below (same values as Fig. 1)
%   columns ........ x positions in the "column grid" block; \rowT/\rowB = top/bottom of the main row
%   boxes .......... styles blk (solid), alt (dashed alternative), port (one input row)
%   flows .......... "% ===== flows" block at the end, style flow (main data) / side (ego, map)
\definecolor{egoc}{RGB}{226,121,44}     % ego vehicle / handover
\definecolor{npcc}{RGB}{47,107,200}     % tracked traffic
\definecolor{recc}{RGB}{46,160,146}     % reconstruction
\definecolor{percc}{RGB}{128,78,160}    % perception
\definecolor{panelbg}{RGB}{243,244,246} % column panels
\definecolor{flowc}{RGB}{90,90,90}      % data-flow arrows

\begin{tikzpicture}[
    font=\scriptsize,
    >={Stealth[length=1.6mm,width=1.3mm]},
    panel/.style={fill=panelbg,rounded corners=3pt},
    head/.style={anchor=north west,font=\footnotesize\bfseries,inner sep=0pt},
    ref/.style={anchor=north west,font=\scriptsize,text=black!55,inner sep=0pt},
    blk/.style={draw=#1!70!black,fill=#1!10,rounded corners=2pt,line width=0.5pt,
                align=center,inner sep=2pt,minimum height=11mm},
    alt/.style={blk=#1,dash pattern=on 2pt off 1pt},
    port/.style={draw=black!45,fill=white,rounded corners=1pt,line width=0.3pt,
                 anchor=west,text width=2.2cm,minimum height=4.6mm,inner sep=1pt,align=left},
    tag/.style={font=\scriptsize\itshape,text=black!60,inner sep=0.5pt},
    flow/.style={->,draw=flowc,line width=0.8pt},
    side/.style={->,draw=flowc!70,line width=0.5pt},
    dlabel/.style={font=\scriptsize,text=black!65,inner sep=1pt,fill=white,fill opacity=0.85,text opacity=1,rounded corners=1pt},
  ]
% ---------- column grid ----------
\def\rowT{1.15}  \def\rowB{-1.15}         % main row
\def\top{2.05}   \def\bot{-2.55}          % panel top/bottom
\def\xIa{0}      \def\xIb{2.6}            % input
\def\xSa{3.0}    \def\xSb{6.0}            % perception source
\def\xRa{6.4}    \def\xRb{13.35}          % trajectory reconstruction
\def\xEa{13.75}  \def\xEb{16.95}          % scenario export
\def\xOa{17.35}  \def\xOb{19.5}           % output

% ---------- column panels ----------
\foreach \a/\b/\t/\r in {\xIa/\xIb/Input/,
                         \xSa/\xSb/Perception source/Sec.~II-B,
                         \xRa/\xRb/Trajectory reconstruction/Sec.~II-C,
                         \xEa/\xEb/Scenario export/Sec.~II-D,
                         \xOa/\xOb/Output/}{
  \fill[panel] (\a,\bot) rectangle (\b,\top);
  \node[head] at (\a+0.12,\top-0.12) {\t};
  \node[ref]  at (\a+0.12,\top-0.42) {\r};
}

% ===== input: recording topics and road map =====
\node[anchor=west,font=\scriptsize\itshape] at (\xIa+0.15,1.25) {MCAP/ ROS bag};
\node[port] (pTrk) at (\xIa+0.2, 0.80) {\textcolor{npcc}{$\blacksquare$}\ object trajectories};
\node[port] (pSen) at (\xIa+0.2, 0.15) {\textcolor{percc}{$\blacksquare$}\ camera, LiDAR};
\node[port] (pEgo) at (\xIa+0.2,-0.50) {\textcolor{egoc}{$\blacksquare$}\ ego state};
\draw[black!45,rounded corners=2pt,line width=0.4pt] (\xIa+0.1,-0.85) rectangle (\xIb-0.1,1.48);
\node[port] (pMap) at (\xIa+0.2,-1.95) {\textcolor{recc}{$\blacksquare$}\ Lanelet2 map};
\node[tag,anchor=south east] at (pMap.north east) {optional};

% ===== perception source: online (default) or offline (alternative) =====
\node[blk=percc,minimum width=2.75cm] (online)  at ($(\xSa,0)!0.5!(\xSb,0)+(0,0.62)$)
  {\textbf{Online}\\recorded tracker output};
\node[alt=percc,minimum width=2.75cm] (offline) at ($(\xSa,0)!0.5!(\xSb,0)+(0,-0.78)$)
  {\textbf{Offline}\\relabeling of recorded\\sensor data (AWML)};
\coordinate (merge) at (\xSb+0.2,0);

% ===== trajectory reconstruction: three stages on the main row =====
\def\bw{2.09}
\node[blk=recc,text width=1.95cm,minimum height=15mm] (split) at (\xRa+0.15+0.5*\bw,0)
  {\textbf{Filter}\\reject invalid\\samples; drop short\\trajectories};
\node[blk=recc,text width=1.95cm,minimum height=15mm,right=0.22cm of split] (assoc)
  {\textbf{Associate}\\join fragments\\of one\\actor; abstain if\\ambiguous};
\node[blk=recc,text width=1.95cm,minimum height=15mm,right=0.22cm of assoc] (fill)
  {\textbf{Complete}\\bounded gap filling,\\extension, actor\\lifetimes};
\node[dlabel,fill=none,anchor=north] at ($(split.south)+(0,-0.12)$) {\shortstack{fragmented\\trajectories}};
\node[dlabel,fill=none,anchor=north] at ($(assoc.south)+(0,-0.12)$) {linked identities};
\node[dlabel,fill=none,anchor=north] at ($(fill.south)+(0,-0.12)$)  {actor trajectories};

% ===== scenario export =====
\node[blk=npcc,minimum height=22mm,align=left,text width=2.8cm]
  (export) at ($(\xEa,0)!0.5!(\xEb,0)+(0,0.05)$)
  {\textbf{OpenSCENARIO \& SUMO export}\\[1pt]
   actors, vehicle models,\\timed trajectories\\[2pt]
   \textit{traffic:} prescribed,\\reactive or hybrid rear cone\\[2pt]
   \textit{ego:} prescribed, autonomous};

% ===== output: scenario file (ego) and traffic plan (co-simulation) =====
% \outdoc{name}{y}{extension}{label}: small document icon centred in the output column at height y
\def\outdoc#1#2#3#4{%
  \begin{scope}[shift={($(\xOa,#2)!0.5!(\xOb,#2)$)},scale=0.62]
    \draw[black!70,fill=white,line width=0.5pt] (-0.62,-0.85) -- (-0.62,0.85) -- (0.37,0.85) -- (0.62,0.6) -- (0.62,-0.85) -- cycle;
    \draw[black!70,line width=0.5pt] (0.37,0.85) -- (0.37,0.6) -- (0.62,0.6);
    \foreach \y in {0.35,0.15,-0.05} \draw[black!25,line width=0.6pt] (-0.42,\y) -- (0.32,\y);
    \node[font=\scriptsize\bfseries] at (0,-0.5) {#3};
    \coordinate (#1) at (-0.62,0);
  \end{scope}
  \node[align=center,anchor=north,font=\scriptsize] at ($(\xOa,#2-0.58)!0.5!(\xOb,#2-0.58)$) {#4};}
\outdoc{xosc}{0.92}{.xosc}{scenario}
\outdoc{plan}{-0.95}{.json}{traffic plan}

% ===== flows =====
\draw[flow] (pTrk.east) -- ++(0.45,0) |- (online.west);
\draw[flow,dash pattern=on 2pt off 1pt] (pSen.east) -- ++(0.45,0) |- (offline.west);
\draw[flow] (online.east)  -| (merge);
\draw[flow,dash pattern=on 2pt off 1pt] (offline.east) -| (merge);
\draw[flow] (merge) -- (split.west);
\draw[flow] (split) -- (assoc);
\draw[flow] (assoc) -- (fill);
\draw[flow] (fill.east) -- (export.west |- fill.east);
\draw[flow] (export.east) -- ++(0.2,0) |- (xosc);
\draw[flow] (export.east) -- ++(0.2,0) |- (plan);
% road map feeds association and completion (lane-frame checks, road support)
\draw[side] (pMap.east) -- (assoc.south |- pMap.east) -- ($(assoc.south)+(0,-0.42)$);
\draw[side] (assoc.south |- pMap.east) -| ($(fill.south)+(0,-0.42)$);
\node[dlabel,fill=none,anchor=south west] at ($(pMap.east)+(0.42,0)$) {lane geometry};
% ego state feeds the export (ego trajectory, intervention time t_d)
\draw[side,draw=egoc!80] (pEgo.east) -- ++(0.12,0) |- ($(\xIb+0.35,\bot+0.18)$) -| ($(export.south)+(0,0)$);
\node[dlabel,fill=none,anchor=south,text=egoc!80!black] at ($(\xSa,\bot+0.18)!0.5!(\xSb,\bot+0.18)$) {ego trajectory, disengagement time $t_d$};
\end{tikzpicture}
